# GitHub Personal Access Token
# Para obter um token:
# 1. Acesse: https://github.com/settings/tokens
# 2. Clique em "Generate new token" > "Generate new token (classic)"
# 3. Dê um nome descritivo (ex: "Portfolio Website")
# 4. Selecione os escopos: "repo" (acesso completo aos repositórios)
# 5. Clique em "Generate token"
# 6. Copie o token e cole abaixo

NEXT_PUBLIC_GITHUB_TOKEN=seu_token_aqui
NEXT_PUBLIC_GITHUB_USERNAME=r90ur7
